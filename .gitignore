# LLMbot active-mainline tracking policy.
#
# Only root-level Python/Markdown files and utils/ are eligible for normal
# commits. Legacy surfaces, package directories, generated artifacts, caches,
# and model weights stay ignored unless a future task explicitly changes this
# policy.

# Ignore everything by default.
*

# Allow directory traversal so later allow rules can match nested paths.
!*/

# Keep this policy file tracked.
!.gitignore

# Active mainline files at LLMbot/ root only.
!/*.py
!/*.md

# Active utility package.
!utils/
!utils/**

# Deprecated or non-synced code surfaces.
baseline/
code/
models/
trainers/
evaluation/
data/

# Generated or heavyweight artifacts.
checkpoints/
saved_artifacts/
saved_models/
wandb/
tmp/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pt
*.pth
*.pkl
*.ckpt
*.safetensors
*.npy
*.npz
