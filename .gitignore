# 备份用：如果需要恢复，请先复制此文件到其他位置
# 忽略所有文件
*

# 但不要忽略目录（保持目录结构）
!*/

# 保留 .gitignore 本身
!.gitignore

# 白名单：允许上传的核心源码文件（按需调整）
!main.py
!model.py
!train.py
!GNNs.py
!RGT.py
!utils.py
!precompute.py
!__init__.py

# 可选：如果你也想上传 llmbot 包中的 trainer 等核心文件，可取消下面注释并按需添加文件
# !llmbot/__init__.py
# !llmbot/Trainer.py
# !llmbot/base_trainer.py
# !llmbot/losses.py
# !llmbot/main.py

# 永远忽略这些大型/临时项
llmbot/
sega/
sega_env/
wandb/
saved_models/
saved_models/checkpoints/
__pycache__/
*.pyc
*.pt
*.pth