# LLMbot active-mainline tracking policy.
#
# Root compatibility Python/Markdown files and the flat code/ active source
# directory are eligible for normal commits. Legacy surfaces, generated
# artifacts, caches, and model weights stay ignored unless a future task
# explicitly changes this policy.

# Ignore everything by default.
*

# Allow directory traversal so later allow rules can match nested paths.
!*/

# Keep this policy file tracked.
!.gitignore

# Active compatibility entrypoints at LLMbot/ root.
!/*.py
!/*.md

# Active flat mainline under code/.
!code/
!code/**

# Deprecated or non-synced code surfaces.
baseline/
models/
trainers/
evaluation/
data/

# Generated or heavyweight artifacts.
checkpoints/
saved_artifacts/
saved_models/
wandb/
tmp/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
*.pt
*.pth
*.pkl
*.ckpt
*.safetensors
*.npy
*.npz
