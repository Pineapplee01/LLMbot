# LLMbot root-mainline tracking policy.
#
# The root mainline lives directly under LLMbot/. Deprecated legacy
# directories such as baseline/ and code/ are intentionally not re-included
# here; handle archival/deletion in a separate explicit task.

*
!*/
!.gitignore

# Root mainline docs and governance.
!AGENTS.md
!README.md

# Root mainline modules.
!main.py
!parser_args.py
!trainer.py
!estimators.py
!operators.py
!model_building.py
!subgroups.py
!GNNs.py
!RGT.py
!LM.py
!SimpleHGN.py
!dataloader.py
!llm_evidence_refiner.py

# Deprecated legacy surfaces stay ignored unless a future task explicitly
# rewrites this policy for archival or deletion.
baseline/
code/
models/
trainers/
evaluation/
data/
utils/

# Generated or heavyweight artifacts.
checkpoints/
saved_artifacts/
saved_models/
wandb/
tmp/
__pycache__/
*.pyc
*.pt
*.pth
